<mxfile host="app.diagrams.net">
  <diagram name="Even or Odd Flowchart" id="even-or-odd-flowchart">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Start -->
        <mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#82B366;fillColor=#D5E8D4;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="345" y="40" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- Enter main -->
        <mxCell id="process1" value="Enter main() function" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="315" y="130" width="220" height="60" as="geometry"/>
        </mxCell>

        <!-- Declare variable -->
        <mxCell id="process2" value="Declare variable:&#xa;int num" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="315" y="230" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- Input num -->
        <mxCell id="io1" value="Output: Enter an integer:&#xa;Input: num" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;strokeColor=#D79B00;fillColor=#FFE6CC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="275" y="340" width="300" height="75" as="geometry"/>
        </mxCell>

        <!-- Decision -->
        <mxCell id="decision1" value="num % 2 == 0 ?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#D6B656;fillColor=#FFF2CC;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="325" y="465" width="200" height="110" as="geometry"/>
        </mxCell>

        <!-- Output even -->
        <mxCell id="io2" value="Output:&#xa;num is even." style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;strokeColor=#D79B00;fillColor=#FFE6CC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="95" y="620" width="260" height="75" as="geometry"/>
        </mxCell>

        <!-- Output odd -->
        <mxCell id="io3" value="Output:&#xa;num is odd." style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;strokeColor=#D79B00;fillColor=#FFE6CC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="495" y="620" width="260" height="75" as="geometry"/>
        </mxCell>

        <!-- Return -->
        <mxCell id="process3" value="Return 0" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="345" y="760" width="160" height="55" as="geometry"/>
        </mxCell>

        <!-- End -->
        <mxCell id="end" value="End" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#82B366;fillColor=#D5E8D4;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="345" y="855" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="start" target="process1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="process1" target="process2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="process2" target="io1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="io1" target="decision1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Yes branch -->
        <mxCell id="edge5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;fontSize=13;" edge="1" parent="1" source="decision1" target="io2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="225" y="520"/>
              <mxPoint x="225" y="620"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- No branch -->
        <mxCell id="edge6" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;fontSize=13;" edge="1" parent="1" source="decision1" target="io3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="625" y="520"/>
              <mxPoint x="625" y="620"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Even to return -->
        <mxCell id="edge7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="io2" target="process3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="225" y="735"/>
              <mxPoint x="425" y="735"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Odd to return -->
        <mxCell id="edge8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="io3" target="process3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="625" y="735"/>
              <mxPoint x="425" y="735"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="edge9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="process3" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>