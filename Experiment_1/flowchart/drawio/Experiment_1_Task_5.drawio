<mxfile host="app.diagrams.net">
  <diagram name="Quotient and Remainder Flowchart" id="quotient-remainder-flowchart">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Start -->
        <mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#82B366;fillColor=#D5E8D4;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="345" y="40" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- Enter main -->
        <mxCell id="process1" value="Enter main() function" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="315" y="130" width="220" height="60" as="geometry"/>
        </mxCell>

        <!-- Declare variables -->
        <mxCell id="process2" value="Declare and initialize variables:&#xa;int A = 0&#xa;int B = 0" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="300" y="230" width="250" height="90" as="geometry"/>
        </mxCell>

        <!-- Input A -->
        <mxCell id="io1" value="Output: Enter A:&#xa;Input: A" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;strokeColor=#D79B00;fillColor=#FFE6CC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="275" y="360" width="300" height="75" as="geometry"/>
        </mxCell>

        <!-- Input B -->
        <mxCell id="io2" value="Output: Enter B:&#xa;Input: B" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;strokeColor=#D79B00;fillColor=#FFE6CC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="275" y="475" width="300" height="75" as="geometry"/>
        </mxCell>

        <!-- Calculate quotient and remainder -->
        <mxCell id="process3" value="Calculate:&#xa;Quotient = A / B&#xa;Remainder = A % B" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="300" y="590" width="250" height="90" as="geometry"/>
        </mxCell>

        <!-- Output quotient -->
        <mxCell id="io3" value="Output:&#xa;Quotient: A / B" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;strokeColor=#D79B00;fillColor=#FFE6CC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="275" y="720" width="300" height="75" as="geometry"/>
        </mxCell>

        <!-- Output remainder -->
        <mxCell id="io4" value="Output:&#xa;Remainder: A % B" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;strokeColor=#D79B00;fillColor=#FFE6CC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="275" y="835" width="300" height="75" as="geometry"/>
        </mxCell>

        <!-- Return -->
        <mxCell id="process4" value="Return 0" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="345" y="950" width="160" height="55" as="geometry"/>
        </mxCell>

        <!-- End -->
        <mxCell id="end" value="End" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#82B366;fillColor=#D5E8D4;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="345" y="1045" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="start" target="process1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="process1" target="process2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="process2" target="io1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="io1" target="io2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="io2" target="process3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="process3" target="io3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="io3" target="io4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="io4" target="process4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="process4" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>