<mxfile host="app.diagrams.net">
  <diagram name="Three Items Receipt Flowchart" id="three-items-receipt-flowchart">
    <mxGraphModel dx="1000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Start -->
        <mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#82B366;fillColor=#D5E8D4;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="345" y="40" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- Enter main -->
        <mxCell id="process1" value="Enter main() function" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="315" y="130" width="220" height="60" as="geometry"/>
        </mxCell>

        <!-- Declare variables -->
        <mxCell id="process2" value="Declare and initialize variables:&#xa;price1 = 0&#xa;price2 = 0&#xa;price3 = 0" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="300" y="230" width="250" height="100" as="geometry"/>
        </mxCell>

        <!-- Input prices -->
        <mxCell id="io1" value="Output:&#xa;Enter prices of three items:&#xa;Input: price1, price2, price3" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;strokeColor=#D79B00;fillColor=#FFE6CC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="265" y="370" width="320" height="90" as="geometry"/>
        </mxCell>

        <!-- Calculate subtotal -->
        <mxCell id="process3" value="Calculate subtotal:&#xa;subtotal = price1 + price2 + price3" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="265" y="500" width="320" height="75" as="geometry"/>
        </mxCell>

        <!-- Calculate tax -->
        <mxCell id="process4" value="Calculate tax:&#xa;tax = subtotal × 0.085" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="300" y="615" width="250" height="70" as="geometry"/>
        </mxCell>

        <!-- Calculate total -->
        <mxCell id="process5" value="Calculate total:&#xa;total = subtotal + tax" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="300" y="725" width="250" height="70" as="geometry"/>
        </mxCell>

        <!-- Format output -->
        <mxCell id="process6" value="Set output format:&#xa;fixed&#xa;setprecision(2)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="300" y="835" width="250" height="85" as="geometry"/>
        </mxCell>

        <!-- Output table -->
        <mxCell id="io2" value="Output formatted receipt table:&#xa;Item / Prices&#xa;Item 1, Item 2, Item 3&#xa;Subtotal, Tax (8.5%), Total" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;strokeColor=#D79B00;fillColor=#FFE6CC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="255" y="960" width="340" height="110" as="geometry"/>
        </mxCell>

        <!-- Return -->
        <mxCell id="process7" value="Return 0" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="345" y="1110" width="160" height="55" as="geometry"/>
        </mxCell>

        <!-- End -->
        <mxCell id="end" value="End" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#82B366;fillColor=#D5E8D4;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="345" y="1205" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="start" target="process1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="process1" target="process2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="process2" target="io1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="io1" target="process3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="process3" target="process4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="process4" target="process5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="process5" target="process6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="process6" target="io2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="io2" target="process7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="process7" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>