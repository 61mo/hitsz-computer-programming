<mxfile host="app.diagrams.net">
  <diagram name="Temperature Conversion Flowchart" id="temperature-conversion-flowchart">
    <mxGraphModel dx="1200" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Start -->
        <mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#82B366;fillColor=#D5E8D4;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="495" y="40" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- Enter main -->
        <mxCell id="process1" value="Enter main() function" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="465" y="130" width="220" height="60" as="geometry"/>
        </mxCell>

        <!-- Output menu -->
        <mxCell id="io1" value="Output menu:&#xa;Select conversion:&#xa;1. Celsius to Fahrenheit&#xa;2. Fahrenheit to Celsius" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;strokeColor=#D79B00;fillColor=#FFE6CC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="375" y="230" width="400" height="115" as="geometry"/>
        </mxCell>

        <!-- Declare variables -->
        <mxCell id="process2" value="Declare variables:&#xa;int choice, temperature" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="435" y="385" width="280" height="70" as="geometry"/>
        </mxCell>

        <!-- Input choice -->
        <mxCell id="io2" value="Output: Enter choice:&#xa;Input: choice" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;strokeColor=#D79B00;fillColor=#FFE6CC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="425" y="495" width="300" height="75" as="geometry"/>
        </mxCell>

        <!-- Input temperature -->
        <mxCell id="io3" value="Output: Enter temperature:&#xa;Input: temperature" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;strokeColor=#D79B00;fillColor=#FFE6CC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="425" y="610" width="300" height="75" as="geometry"/>
        </mxCell>

        <!-- Decision choice == 1 -->
        <mxCell id="decision1" value="choice == 1 ?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#D6B656;fillColor=#FFF2CC;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="475" y="735" width="200" height="110" as="geometry"/>
        </mxCell>

        <!-- Celsius to Fahrenheit -->
        <mxCell id="process3" value="Call function:&#xa;celsiusToFahrenheit(temperature)&#xa;result = temperature × 9.0 / 5.0 + 32" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="55" y="760" width="340" height="100" as="geometry"/>
        </mxCell>

        <!-- Output Fahrenheit -->
        <mxCell id="io4" value="Output with fixed precision:&#xa;Temperature in Fahrenheit: result" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;strokeColor=#D79B00;fillColor=#FFE6CC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="55" y="910" width="340" height="85" as="geometry"/>
        </mxCell>

        <!-- Decision choice == 2 -->
        <mxCell id="decision2" value="choice == 2 ?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#D6B656;fillColor=#FFF2CC;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="475" y="910" width="200" height="110" as="geometry"/>
        </mxCell>

        <!-- Fahrenheit to Celsius -->
        <mxCell id="process4" value="Call function:&#xa;fahrenheitToCelsius(temperature)&#xa;result = (temperature - 32) × 5.0 / 9.0" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="755" y="930" width="350" height="100" as="geometry"/>
        </mxCell>

        <!-- Output Celsius -->
        <mxCell id="io5" value="Output with fixed precision:&#xa;Temperature in Celsius: result" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;strokeColor=#D79B00;fillColor=#FFE6CC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="755" y="1080" width="350" height="85" as="geometry"/>
        </mxCell>

        <!-- Invalid choice -->
        <mxCell id="io6" value="Output:&#xa;Invalid choice!" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;strokeColor=#D79B00;fillColor=#FFE6CC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="425" y="1080" width="300" height="75" as="geometry"/>
        </mxCell>

        <!-- Return -->
        <mxCell id="process5" value="Return 0" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="495" y="1260" width="160" height="55" as="geometry"/>
        </mxCell>

        <!-- End -->
        <mxCell id="end" value="End" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#82B366;fillColor=#D5E8D4;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="495" y="1360" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- Main arrows -->
        <mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="start" target="process1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="process1" target="io1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="io1" target="process2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="process2" target="io2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="io2" target="io3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="io3" target="decision1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- choice == 1 yes -->
        <mxCell id="edge7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;fontSize=13;" edge="1" parent="1" source="decision1" target="process3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="225" y="790"/>
              <mxPoint x="225" y="760"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- choice == 1 no -->
        <mxCell id="edge8" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;fontSize=13;" edge="1" parent="1" source="decision1" target="decision2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="process3" target="io4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- choice == 2 yes -->
        <mxCell id="edge10" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;fontSize=13;" edge="1" parent="1" source="decision2" target="process4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="930" y="965"/>
              <mxPoint x="930" y="930"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- choice == 2 no -->
        <mxCell id="edge11" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;fontSize=13;" edge="1" parent="1" source="decision2" target="io6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="process4" target="io5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Branches to return -->
        <mxCell id="edge13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="io4" target="process5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="225" y="1225"/>
              <mxPoint x="575" y="1225"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="edge14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="io5" target="process5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="930" y="1225"/>
              <mxPoint x="575" y="1225"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="edge15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="io6" target="process5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="process5" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>