<mxfile host="app.diagrams.net">
  <diagram name="Math Functions Flowchart" id="math-functions-flowchart">
    <mxGraphModel dx="1200" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Start -->
        <mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#82B366;fillColor=#D5E8D4;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="445" y="40" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- Enter main -->
        <mxCell id="process1" value="Enter main() function" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="415" y="130" width="220" height="60" as="geometry"/>
        </mxCell>

        <!-- Declare variable -->
        <mxCell id="process2" value="Declare variable:&#xa;double n" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="425" y="230" width="200" height="70" as="geometry"/>
        </mxCell>

        <!-- Input n -->
        <mxCell id="io1" value="Output: Enter a number:&#xa;Input: n" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;strokeColor=#D79B00;fillColor=#FFE6CC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="375" y="340" width="300" height="75" as="geometry"/>
        </mxCell>

        <!-- Decision n <= 0 -->
        <mxCell id="decision1" value="n &lt;= 0 ?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#D6B656;fillColor=#FFF2CC;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="425" y="465" width="200" height="110" as="geometry"/>
        </mxCell>

        <!-- Invalid output -->
        <mxCell id="io_invalid" value="Output:&#xa;Invalid input." style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;strokeColor=#D79B00;fillColor=#FFE6CC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="705" y="485" width="260" height="75" as="geometry"/>
        </mxCell>

        <!-- Set format -->
        <mxCell id="process3" value="Set output format:&#xa;fixed&#xa;setprecision(2)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="400" y="625" width="250" height="85" as="geometry"/>
        </mxCell>

        <!-- Output floor -->
