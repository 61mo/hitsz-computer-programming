          <mxGeometry x="375" y="865" width="300" height="75" as="geometry"/>
        </mxCell>

        <!-- Output absolute value -->
        <mxCell id="io4" value="Output:&#xa;Absolute value: abs(n)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;strokeColor=#D79B00;fillColor=#FFE6CC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="375" y="980" width="300" height="75" as="geometry"/>
        </mxCell>

        <!-- Output log10 -->
