          <mxGeometry x="415" y="585" width="270" height="60" as="geometry"/>
        </mxCell>

        <!-- Decision 1 -->
        <mxCell id="decision1" value="n1 &gt;= n2 &amp;&amp;&#xa;n1 &gt;= n3 ?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#D6B656;fillColor=#FFF2CC;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="690" width="200" height="120" as="geometry"/>
        </mxCell>

        <!-- Return n1 -->
        <mxCell id="process5" value="Return n1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="90" y="720" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- Decision 2 -->
        <mxCell id="decision2" value="n2 &gt;= n1 &amp;&amp;&#xa;n2 &gt;= n3 ?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#D6B656;fillColor=#FFF2CC;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="865" width="200" height="120" as="geometry"/>
        </mxCell>

        <!-- Return n2 -->
