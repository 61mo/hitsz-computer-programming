        <mxCell id="process2" value="Declare variables:&#xa;int n1, n2, n3" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="230" width="260" height="70" as="geometry"/>
        </mxCell>

        <!-- Input -->
        <mxCell id="io1" value="Output: Enter three numbers:&#xa;Input: n1, n2, n3" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;strokeColor=#D79B00;fillColor=#FFE6CC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="390" y="340" width="320" height="80" as="geometry"/>
        </mxCell>

        <!-- Call function -->
        <mxCell id="process3" value="Call function:&#xa;findMax(n1, n2, n3)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="405" y="465" width="290" height="75" as="geometry"/>
        </mxCell>

        <!-- Enter function -->
